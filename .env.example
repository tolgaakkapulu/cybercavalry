# ─────────────────────────────────────────────────────────────
#  CYBERCavalry — environment template
#  Copy this file to `.env`, then fill in the real values.
#  NEVER commit `.env` — it is already in `.gitignore`.
# ─────────────────────────────────────────────────────────────

# ── Core Django ──────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-64-char-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# ── Database ─────────────────────────────────────────────────
# SQLite for dev; use postgres://user:pass@host:5432/dbname in production.
DATABASE_URL=sqlite:///cybercavalry.db

# ── Encryption key for secret Settings (SMTP/API keys/LDAP pw) ──
# Generate the same way as SECRET_KEY. If lost, existing encrypted
# secrets cannot be decrypted — treat it like an HSM key.
FIELD_ENCRYPTION_KEY=change-me-with-a-64-char-random-string

# ── Admin panel path & access ─────────────────────────────────
# The admin URL is loaded from here so it never appears in source.
ADMIN_PATH=admin-console/
# Comma-separated list of IPs allowed to reach the admin panel.
# Every other IP receives a 404 (no confirmation the path exists).
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ── SSL certificates (relative to the project root) ──────────
SSL_CERT_FILE=certs/cert.pem
SSL_KEY_FILE=certs/key.pem

# ── LDAP (optional — leave LDAP_ENABLED=False to skip) ───────
LDAP_ENABLED=False
LDAP_SERVER_URI=ldaps://dc01.example.corp:636
LDAP_BIND_DN=CN=svc-cybercavalry,OU=ServiceAccounts,DC=example,DC=corp
LDAP_BIND_PASSWORD=change-me
LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=corp
LDAP_USER_SEARCH_FILTER=(sAMAccountName=%(user)s)
LDAP_USER_ATTR_MAP={"first_name": "givenName", "last_name": "sn", "email": "mail"}
