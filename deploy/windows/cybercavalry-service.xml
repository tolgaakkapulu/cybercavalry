<?xml version="1.0" encoding="UTF-8"?>
<!--
  CYBERCavalry - WinSW service definition.
  WinSW docs: https://github.com/winsw/winsw

  Adjust the two InstallDir path prefixes below if you deployed to a
  location other than C:\CYBERCavalry.
-->
<service>
  <id>CYBERCavalry</id>
  <name>CYBERCavalry</name>
  <description>CYBER Cavalry - self-hosted threat intelligence and blacklist platform</description>

  <executable>C:\CYBERCavalry\venv\Scripts\python.exe</executable>
  <arguments>-m waitress --port=8443 --threads=8 --url-scheme=https cybercavalry.wsgi:application</arguments>
  <workingdirectory>C:\CYBERCavalry</workingdirectory>

  <env name="DJANGO_SETTINGS_MODULE" value="cybercavalry.settings.base"/>
  <env name="PYTHONUNBUFFERED"       value="1"/>
  <env name="PYTHONIOENCODING"       value="utf-8"/>

  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="none"/>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
    <pattern>yyyyMMdd</pattern>
  </log>
  <logpath>C:\CYBERCavalry\logs</logpath>

  <priority>Normal</priority>
  <stoptimeout>30 sec</stoptimeout>
</service>
